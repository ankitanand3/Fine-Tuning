      "Student: 82.14665593431295\n",
      "Teacher: 42.78125443808166\n"
     ]
    }
   ],
   "source": [
    "print(\"Student:\", perplexity(student, val_loader))\n",
    "print(\"Teacher:\", perplexity(teacher, val_loader))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "8e02921a",
   "metadata": {},
   "outputs": [],
   "source": [
    "def token_accuracy(model, loader):\n",
    "    model.eval()\n",
    "    correct = 0\n",
    "    total = 0\n",
    "    with torch.no_grad():\n",
    "        for batch in loader:\n",
    "            inputs = batch[\"input_ids\"].to(device)\n",
    "            labels = batch[\"labels\"].to(device)\n",
    "            logits = model(inputs).logits              # [batch, seq, vocab]\n",
    "            preds = logits[:, :-1, :].argmax(dim=-1)    # model's top next-token guess\n",
    "            targets = labels[:, 1:]                     # the actual next token\n",
    "            correct += (preds == targets).sum().item()  # count the matches\n",
    "            total += targets.numel()                    # count all positions\n",
    "    return correct / total * 100"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 56,
   "id": "0caa2a29",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Student: 25.816479369409322\n",
      "Teacher: 33.64949333511845\n"
     ]
    }
   ],
   "source": [
    "print(\"Student:\", token_accuracy(student, val_loader))\n",
    "print(\"Teacher:\", token_accuracy(teacher, val_loader))"
   ]
  },
