  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "89bb9ca9",
   "metadata": {},
   "outputs": [],
   "source": [
    "block_size = 128"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "7778b567",
   "metadata": {},
   "outputs": [],
   "source": [
    "def group_texts(batch):\n",
    "    concatenated = sum(batch[\"input_ids\"], [])\n",
    "    total_length = (len(concatenated) // block_size) * block_size\n",
    "    blocks = []\n",
    "    for i in range(0, total_length, block_size):\n",
    "        blocks.append(concatenated[i : i + block_size])\n",
    "    return {\"input_ids\": blocks, \"labels\": [b.copy() for b in blocks]}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "599423f0",
   "metadata": {},
   "outputs": [
    {
     "data": {
