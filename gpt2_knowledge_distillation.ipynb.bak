  {
   "cell_type": "markdown",
   "id": "4e289493",
   "metadata": {},
   "source": [
    "### Distillation Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a48f1372",
   "metadata": {},
   "outputs": [],
   "source": [
    "temperature = 2.0\n",
    "alpha = 0.7\n",
    "ce_loss = nn.CrossEntropyLoss()\n",
    "kl_loss = nn.KLDivLoss(reduction='batchmean')\n",
    "optimizer = optim.Adam(student.parameters(), lr=1e-5)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "43717208",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. tell the dataset to hand back torch tensors (only these two columns)\n",
    "lm_dataset.set_format(\"torch\", columns=[\"input_ids\", \"labels\"])\n",
    "\n",
    "# 2. make the loader that yields batches\n",
    "train_loader = DataLoader(lm_dataset[\"train\"], batch_size=64, shuffle=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c666a63a",
   "metadata": {},
   "source": [
    "### Setting up training loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ee6dd8e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def distill(student, teacher, loader, val_loader, epochs=15):\n",
    "    train_losses, val_perplexities = [], []\n",
    "    best_ppl, best_ep = float(\"inf\"), 0\n",
    "    for ep in range(epochs):\n",
    "        student.train()\n",
    "        total_loss = 0\n",
    "        for batch in loader:\n",
    "            inputs = batch[\"input_ids\"].to(device)\n",
    "            true_answers = batch[\"labels\"].to(device)\n",
    "            with torch.no_grad():\n",
    "                t_logits = teacher(inputs).logits\n",
    "                t_probs = torch.softmax(t_logits / temperature, dim=-1)\n",
    "            s_logits = student(inputs).logits\n",
    "            s_log_probs = torch.log_softmax(s_logits / temperature, dim=-1)\n",
    "            loss_soft = kl_loss(s_log_probs, t_probs) * (temperature**2)\n",
    "            loss_hard = ce_loss(s_logits[:, :-1, :].reshape(-1, s_logits.size(-1)),\n",
    "                                true_answers[:, 1:].reshape(-1))\n",
    "            loss = alpha * loss_soft + (1 - alpha) * loss_hard\n",
    "            optimizer.zero_grad()\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            total_loss += loss.item()\n",
    "\n",
    "        avg_loss = total_loss / len(loader)\n",
    "        val_ppl = perplexity(student, val_loader)      # ← the early-stopping signal\n",
    "        train_losses.append(avg_loss)\n",
    "        val_perplexities.append(val_ppl)\n",
    "\n",
    "        if val_ppl < best_ppl:\n",
    "            best_ppl, best_ep = val_ppl, ep + 1\n",
    "            marker = \"  <-- best so far\"\n",
    "        else:\n",
    "            marker = \"  ^ worse (overfitting?)\"\n",
    "        print(f\"Epoch {ep+1:2d} | train loss {avg_loss:8.2f} | val ppl {val_ppl:7.2f}{marker}\")\n",
    "\n",
    "    print(f\"\\nBest validation perplexity: {best_ppl:.2f} at epoch {best_ep}\")\n",
    "    return train_losses, val_perplexities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "6fdc471b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Student Epoch 1: Loss = 107.3512\n",
      "Student Epoch 2: Loss = 91.1210\n",
      "Student Epoch 3: Loss = 83.6187\n",
      "Student Epoch 4: Loss = 79.0139\n",
      "Student Epoch 5: Loss = 74.8745\n",
      "Student Epoch 6: Loss = 71.8005\n"
     ]
    }
   ],
   "source": [
    "distill(student, teacher, train_loader)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "1695229e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import math\n",
    "\n",
    "def perplexity(model, loader):\n",
    "    model.eval()\n",
    "    total_loss = 0\n",
    "    count = 0\n",
    "    with torch.no_grad():\n",
    "        for batch in loader:\n",
    "            inputs = batch[\"input_ids\"].to(device)\n",
    "            labels = batch[\"labels\"].to(device)\n",
    "            out = model(inputs, labels=labels)\n",
    "            total_loss += out.loss.item()\n",
    "            count += 1\n",
    "    return math.exp(total_loss / count)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "1a22c9b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "val_loader = DataLoader(lm_dataset[\"validation\"], batch_size=8)   # no shuffle for eval"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 52,
   "id": "e7e70aaa",
   "metadata": {},
   "outputs": [
    {
