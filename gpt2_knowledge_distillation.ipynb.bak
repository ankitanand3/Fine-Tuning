    "def keep_row(example):\n",
    "    text = example[\"text\"].strip()\n",
    "    return text != \"\" and not text.startswith(\"=\")\n",
    "\n",
    "ds = ds.filter(keep_row)\n",
    "\n",
    "print(len(ds[\"train\"]))   # expect ~17k, down from 36,718"
   ]
  },
